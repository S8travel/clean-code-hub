.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dev-dist
*.local

# TypeScript build cache (sinh ra bởi `tsc -b`)
*.tsbuildinfo

# Backup database Supabase (chứa dữ liệu thật — TUYỆT ĐỐI không commit)
/backups/

# ── DỮ LIỆU THẬT: repo này đang PUBLIC. Không file nào dưới đây được commit. ──
# Xuất Excel / báo cáo / dump từ DB chạy thật — chứa mã đoàn, giá NCC, doanh thu.
*.xlsx
*.xls
*.csv
.~lock.*#
*-backup.json
# Báo cáo & khảo sát nội bộ sinh ra trong lúc làm việc (số liệu thật)
BAO_TRI_HE_THONG_*.md
Bao_cao_*.md
Danh_gia_*.md
CODE_REVIEW_*.md
LEAD_PLAYBOOK.md

# VAPID private key cho Web Push (paste vào secret edge fn, KHÔNG commit)
vapid-keys.local.json

# Supabase CLI sinh ra khi chạy lệnh link/secrets local
supabase/.temp/

# Claude Code — settings cá nhân/local (KHÔNG commit — có thể chứa key/lệnh nhạy cảm)
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ảnh nguồn cho website giới thiệu (logo KS / du thuyền / nhà hàng) — chỉ là kho ảnh tạm, không commit
_S8_WEB_ANH/

# Tài liệu nội bộ / thuyết trình / đào tạo để tạm ở thư mục gốc (S8-*.html, S8-*.docx).
# Repo NÀY LÀ PUBLIC — trong đó có tên nhà cung cấp thật kèm giá vốn, số liệu quy mô
# kinh doanh và bài chuẩn bị đàm phán đối tác. Lỡ commit là không thu hồi được (xoá
# sau vẫn còn trong lịch sử git). Cần lưu trữ thì để ngoài repo.
S8-*.html
S8-*.docx
